{
  "name": "flowbridge",
  "version": "0.1.0",
  "description": "Configurable automation toolkit for APIs, data processing, and browser tasks",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "demo:offline": "tsx scripts/offline-demo.ts","demo:csv": "tsx src/cli.ts run workflows/api-to-csv.yaml",
    "demo:db": "tsx src/cli.ts run workflows/api-to-sqlite-report.yaml",
    "demo:browser": "tsx src/cli.ts run workflows/browser-form.yaml",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "csv-stringify": "^6.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.5"
  },
  "private": true,
  "bin": {
    "flowbridge": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
